# Publish only reviewed development files. Local state is excluded by default.
/*
!/.gitignore
!/.gitattributes
!/build.ps1
!/README.md
!/docs/
!/outputs/
!/work/
/docs/*
!/docs/*.md
/outputs/*
!/outputs/tennis-local/
/outputs/tennis-local/*
!/outputs/tennis-local/*.py
!/outputs/tennis-local/*.cmd
!/outputs/tennis-local/*.ps1
!/outputs/tennis-local/*.md
!/outputs/tennis-local/requirements.txt
!/outputs/tennis-local/preferences.json
!/outputs/tennis-local/chrome-extension/
/outputs/tennis-local/chrome-extension/*
!/outputs/tennis-local/chrome-extension/*.js
!/outputs/tennis-local/chrome-extension/*.html
!/outputs/tennis-local/chrome-extension/manifest.json
!/outputs/tennis-local/chrome-extension/package.json
!/outputs/tennis-local/chrome-extension/README.md
!/outputs/tennis-local/chrome-extension/notification.png
/work/*
!/work/test_verification_guard.cjs
!/work/test_diagnostic_scope.py
!/work/verification-guard.json

# Defense in depth if the allowlist is extended later.
**/node_modules/
**/.venv/
**/__pycache__/
**/chrome-profile/
**/inspection/
**/*.encrypted.json
**/tennis-card*.json
**/.env*
**/*.zip
**/*authorization*.json
**/*run-history*.json
**/*checkout-records*.json

# Historical local activity notes contain account-specific observations.
/outputs/tennis-local/PROGRESS.md
/outputs/tennis-local/NORMAL-CHROME-STATUS.md
